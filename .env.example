# OpsVault ports (defaults avoid OpsGate: 5173 / 8787)
OPS_VAULT_WEB_PORT=5180
OPS_VAULT_API_PORT=8790

# Optional: full API URL for the Vite proxy
# VITE_API_PROXY=http://127.0.0.1:8790

# Optional extra CORS origins (comma-separated)
# OPS_VAULT_CORS_ORIGINS=http://localhost:3000

# SQLite data directory
# OPS_VAULT_DATA=./data

# SMTP — auto-email share links to recipients (optional)
# OPS_VAULT_SMTP_HOST=smtp.example.com
# OPS_VAULT_SMTP_PORT=465
# OPS_VAULT_SMTP_SECURE=true
# OPS_VAULT_SMTP_USER=opsvault@example.com
# OPS_VAULT_SMTP_PASS=***
# OPS_VAULT_SMTP_FROM=OpsVault <opsvault@example.com>
